---
// Ficha de un tour con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /tours/<slug>/.
// Diseño «sello y entrada»: banda crema con migas y cabecera partida (título, texto, duración y precio; a la
// derecha la foto como sello de correos troquelado con el matasellos de la duración o, sin foto, el icono
// grande); banda de papel con el `detalle` y, al lado, la entrada con talón (datos del tour y botones de
// reserva y WhatsApp); fotos en banda piedra; y otros tours en banda azul.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: `/#${f.idSeccion}` },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const reserva = Object.entries(site.secciones).find(([k, x]) => x.activa && (k === 'reserva' || x.tipo === 'reserva'))?.[0];
const destino = reserva ? `/#${reserva}` : seccion('contacto') ? '/#contacto' : site.boton_cabecera?.url || '/#contacto';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const etiquetas: Record<string, string> = { punto_encuentro: 'Punto de encuentro' };
const duracion = f.datos.find((d) => d.clave === 'duracion')?.valor ?? '';
const datos = f.datos.filter((d) => d.clave !== 'precio' && d.clave !== 'duracion');
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda banda--crema ficha-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class="ficha-hero">
        <div class="ficha-hero-texto">
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1 class="titulo-seccion">{f.titulo}</h1>
          {f.texto && <p class="titular-texto suave">{f.texto}</p>}
          {(duracion || f.precio) && (
            <p class="ficha-chips">
              {duracion && <span class="chip-duracion"><Icono nombre="reloj" tam={18} /> {duracion}</span>}
              {f.precio && <span class="ficha-precio">{f.precio}</span>}
            </p>
          )}
          <div class="ficha-botones">
            <a class="btn" href={destino}>Reservar plaza<Icono nombre="flecha" class="flecha" tam={18} /></a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> Preguntar</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="sello sello--ficha">
            <div class="sello-dentro">
              <div class="sello-foto">
                <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad respaldo="/placeholders/tour.svg" />
                {duracion && <span class="matasellos" aria-hidden="true">{duracion}</span>}
                {f.precio && <span class="sello-valor">{f.precio}</span>}
              </div>
            </div>
          </div>
        ) : (
          <div class="ficha-icono" aria-hidden="true"><Icono nombre={f.icono || 'brujula'} tam={96} /></div>
        )}
      </div>
    </div>
  </section>

  <section class="banda banda--papel seccion">
    <div class="contenedor ficha-cuerpo">
      <article class="ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        <div class="entrada">
          <div class="entrada-talon p-6">
            <h2 class="ficha-lado-titulo">Tu entrada</h2>
            <dl class="ficha-datos">
              {f.precio && <div><dt>Precio</dt><dd class="ficha-precio">{f.precio}</dd></div>}
              {duracion && <div><dt>Duración</dt><dd>{duracion}</dd></div>}
              {datos.map((d) => <div><dt>{etiquetas[d.clave] ?? d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
          <div class="ficha-cita p-6">
            <p class="suave">Reservar es gratis y te confirmo la plaza el mismo día.</p>
            <a class="btn" href={destino}>Reservar plaza<Icono nombre="flecha" class="flecha" tam={18} /></a>
            {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
          </div>
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="banda banda--piedra" aria-label={`Fotos de ${f.titulo}`}>
      <div class="contenedor ficha-galeria-caja">
        <ul class="ficha-galeria">
          {f.imagenes.map((src, i) => (
            <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} class="h-full w-full object-cover" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="banda banda--azul seccion">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo="Otros tours" />
        <ul class="ficha-otras">
          {otras.map((o) => (
            <li class="ficha-otra">
              <span class="insignia"><Icono nombre={o.icono || 'brujula'} tam={22} /></span>
              <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p class="suave">{o.texto}</p>}
              <p class="ficha-otra-pie">
                {o.precio && <span class="ficha-precio">{o.precio}</span>}
                <span class="ficha-otra-ver" aria-hidden="true">Ver <Icono nombre="flecha" tam={16} /></span>
              </p>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn" href={`/#${f.idSeccion}`}>Ver todos los tours</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3rem, 6vw, 5rem); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-size: .92rem; font-weight: 700; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "›"; opacity: .5; }
  .migas a { color: var(--teja-texto); text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { text-decoration: underline; }
  .migas [aria-current] { opacity: .7; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; margin-top: clamp(.5rem, 2vw, 1.5rem); align-items: center; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(2.4rem, 7vw, 5rem); overflow-wrap: anywhere; }
  .ficha-chips { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.25rem; margin-top: 1.5rem; }
  .chip-duracion { display: inline-flex; align-items: center; gap: .45rem; padding: .35rem .9rem; border-radius: 999px; border: 2px solid var(--teja); color: var(--teja-texto); font-weight: 800; }
  .ficha-precio { font-weight: 900; font-size: 1.25rem; letter-spacing: -.02em; color: var(--teja-texto); overflow-wrap: anywhere; }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .ficha-botones a, .ficha-cita .btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
  .sello--ficha { height: auto; }
  .ficha-icono { display: grid; place-items: center; aspect-ratio: 4 / 3; border-radius: var(--radio); background: var(--papel); color: var(--teja); border: 2px dashed var(--linea); }
  .ficha-cuerpo { display: grid; gap: 3rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.12rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-size: 1.28rem; font-family: var(--fuente-serif); font-style: italic; }
  .ficha-lado { align-self: start; }
  .ficha-lado-titulo { font-size: 1.6rem; margin-bottom: 1rem; }
  .ficha-datos { display: grid; }
  .ficha-datos > div { display: flex; justify-content: space-between; gap: 1rem; padding: .7rem 0; border-top: 1px dotted var(--linea); }
  .ficha-datos dt { font-weight: 800; opacity: .7; }
  .ficha-datos dd { text-align: right; font-weight: 700; min-width: 0; overflow-wrap: anywhere; }
  .ficha-cita { display: grid; gap: .9rem; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 800; color: var(--tinta); text-decoration: none; }
  .ficha-galeria-caja { padding-block: clamp(2.5rem, 5vw, 4rem); }
  .ficha-galeria { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 4 / 3; border-radius: var(--radio); overflow: hidden; }
  .ficha-otras { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .7rem; padding: 1.5rem; border-radius: var(--radio); background: var(--papel); color: var(--tinta); }
  .ficha-otra h3 { font-size: 1.5rem; margin-top: .35rem; overflow-wrap: anywhere; }
  .ficha-otra .suave { color: var(--suave); }
  .ficha-otra-enlace { text-decoration: none; color: inherit; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; border-radius: var(--radio); }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 3px solid var(--claro); outline-offset: 3px; }
  .ficha-otra-pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .5rem; }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .3rem; font-weight: 800; color: var(--teja-texto); }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 4rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 6.5rem; }
  }
</style>
