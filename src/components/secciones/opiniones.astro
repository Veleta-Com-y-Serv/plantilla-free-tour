---
// Opiniones: banda rojo teja con borde troquelado. La primera de `testimonios: [{texto, autor, nota}]` va como cita
// enorme en serif cursiva a todo el ancho; el resto, en columnas con una línea de puntos arriba.
// Sin testimonios no se pinta (la plataforma nunca inventa opiniones).
import { seccion, cadena } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const lista = (s?.testimonios ?? []).filter((t) => cadena(t.texto));
const [primera, ...resto] = lista;
const columnas = resto.length >= 3 ? 'md:grid-cols-3' : resto.length === 2 ? 'md:grid-cols-2' : '';
---

{
  s && primera && (
    <Seccion id={id} banda="teja" class="troquel">
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      <figure class="grid gap-4 lg:grid-cols-[7rem_minmax(0,1fr)] lg:gap-10">
        <span class="comillas" aria-hidden="true">&ldquo;</span>
        <div>
          <blockquote class="cita-grande max-w-[64rem]">{primera.texto}</blockquote>
          <figcaption class="mt-7 flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <span class="text-lg font-black">{primera.autor}</span>
            {cadena(primera.nota) && <span class="suave">{primera.nota}</span>}
          </figcaption>
        </div>
      </figure>
      {resto.length > 0 && (
        <ul class:list={['mt-16 grid gap-10 md:mt-20 lg:gap-14', columnas]}>
          {resto.map((t) => (
            <li class="opinion">
              <figure>
                <blockquote class="text-lg leading-relaxed">«{t.texto}»</blockquote>
                <figcaption class="mt-5">
                  <span class="block font-black">{t.autor}</span>
                  {cadena(t.nota) && <span class="suave serif mt-1 block italic">{t.nota}</span>}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      )}
    </Seccion>
  )
}
